{
  "name": "give-add-on-donate-to-access-content",
  "version": "3.0.0",
  "description": "Add on to WordPress Give donation plugin",
  "main": "assets-src/js/main.js",
  "scripts": {
    "css-build-bulma": "sass --quiet-deps --load-path=node_modules assets-src/scss/bulma.scss assets/css/bulma.css",
    "css-build-plugin-styles": "sass --quiet-deps assets-src/scss/style.scss assets/css/style.css",
    "css-deploy": "npm run css-build-bulma && npm run css-build-plugin-styles && npm run css-postcss-bulma && npm run css-postcss-plugin",
    "css-postcss-bulma": "postcss assets/css/bulma.css --use autoprefixer --output assets/css/bulma.css",
    "css-postcss-plugin": "postcss assets/css/style.css --use autoprefixer --output assets/css/style.css",
    "css-watch": "sass --watch --quiet-deps --load-path=node_modules assets-src/scss:assets/css",
    "deploy": "npm run css-deploy && npm run js-build",
    "js-build": "babel assets-src/js --out-dir assets/js",
    "js-watch": "babel assets-src/js --out-dir assets/js --watch",
    "start": "npm-run-all --parallel css-watch js-watch",
    "test": "npm run test:js",
    "test:js": "node --test tests/js/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/contriveitup/give-add-on-donate-to-access-content.git"
  },
  "keywords": [
    "WordPress",
    "Addon",
    "Give",
    "Donate",
    "Access",
    "Content",
    "Donate",
    "to",
    "access",
    "content",
    "contriveitup"
  ],
  "author": "Rupak Dhiman",
  "license": "GPL-3.0-or-later",
  "bugs": {
    "url": "https://github.com/contriveitup/give-add-on-donate-to-access-content/issues"
  },
  "homepage": "https://github.com/contriveitup/give-add-on-donate-to-access-content#readme",
  "engines": {
    "node": ">=18"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ],
  "devDependencies": {
    "@babel/cli": "^7.25.9",
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "autoprefixer": "^10.4.20",
    "bulma": "^0.9.4",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.49",
    "postcss-cli": "^11.0.0",
    "sass": "^1.80.6"
  }
}
